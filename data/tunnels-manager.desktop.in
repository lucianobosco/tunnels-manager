[Desktop Entry]
Type=Application
Name=Tunnels Manager
GenericName=IAP tunnel manager
Comment=Open and close Google Cloud IAP tunnels and port-forwards
Exec=@EXEC@
Icon=@APP_ID@
Terminal=false
Categories=Network;RemoteAccess;
Keywords=tunnel;iap;gcloud;mysql;cloudsql;bastion;port-forward;
StartupNotify=true
StartupWMClass=@APP_ID@
