#!/usr/bin/env python3
"""Launcher for Tunnels Manager.

Resolves its own symlink so that ~/.local/bin/tunnels-manager finds the package.
"""

import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))

from tunnels_manager.cli import main  # noqa: E402

if __name__ == "__main__":
    sys.exit(main())
